[node name="Light" type="OmniLight3D" parent="."]
light_color = Color(0.2, 0.5, 1, 1)
light_energy = 1.3
omni_range = 4.0

[node name="Timeline" type="Node" parent="." node_paths=PackedStringArray("Surfaces", "Lights", "Emitters")]
script = ExtResource("timeline")
LightFlicker = 2
Surfaces = [NodePath("../Core"), NodePath("../Shell"), NodePath("../Trail")]
