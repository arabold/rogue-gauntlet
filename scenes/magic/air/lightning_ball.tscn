[ext_resource type="Texture2D" path="res://scenes/magic/air/toon_storm_spark_life.tres" id="spark_life"]
[ext_resource type="Material" path="res://scenes/magic/shared/toon/toon_spark_material.tres" id="spark_material_res"]

[sub_resource type="ShaderMaterial" id="core_material"]
shader = ExtResource("core_shader")
shader_parameter/color_ramp = ExtResource("storm_ramp")
shader_parameter/brightness = 2.2
shader_parameter/heat_bias = 0.2

[sub_resource type="ShaderMaterial" id="shell_material"]
render_priority = 1
shader = ExtResource("shell_shader")
shader_parameter/intensity = 1.5

[sub_resource type="ShaderMaterial" id="trail_material"]
render_priority = -1
shader = ExtResource("trail_shader")

[sub_resource type="SphereMesh" id="core_mesh"]
radius = 0.3
height = 0.6
radial_segments = 10
rings = 6

[sub_resource type="SphereMesh" id="shell_mesh"]
radius = 0.57
height = 1.14
radial_segments = 16
rings = 8

[sub_resource type="ParticleProcessMaterial" id="particles"]
particle_flag_align_y = true
emission_shape = 1
emission_sphere_radius = 0.3
direction = Vector3(0, 1, 0)
spread = 180.0
initial_velocity_min = 0.7
initial_velocity_max = 2.4
gravity = Vector3(0, 0, 0)
scale_min = 0.8
scale_max = 1.4
color_ramp = ExtResource("spark_life")

[sub_resource type="QuadMesh" id="spark_mesh"]
size = Vector2(0.07, 0.24)

[node name="LightningBall" type="Node3D" node_paths=PackedStringArray("Timeline", "Core", "Shell", "Trails", "Sparks")]
script = ExtResource("ball")
Timeline = NodePath("Timeline")
Core = NodePath("Core")
Shell = NodePath("Shell")
Trails = [NodePath("Trail")]
Sparks = NodePath("Sparks")
ImpactScene = ExtResource("impact")

[node name="Core" type="MeshInstance3D" parent="."]
material_override = SubResource("core_material")
cast_shadow = 0
mesh = SubResource("core_mesh")

[node name="Shell" type="MeshInstance3D" parent="."]
material_override = SubResource("shell_material")
cast_shadow = 0
