[node name="Trail" type="MeshInstance3D" parent="." node_paths=PackedStringArray("Target")]
material_override = SubResource("trail_material")
cast_shadow = 0
script = ExtResource("ribbon")
Target = NodePath("..")
MaxPoints = 30
PointSpacing = 0.08
Width = 1.0
TailWidthScale = 0.5
MeshUpdateInterval = 0.025

[node name="Sparks" type="GPUParticles3D" parent="."]
material_override = ExtResource("spark_material_res")
cast_shadow = 0
amount = 30
lifetime = 0.5
local_coords = false
process_material = SubResource("particles")
