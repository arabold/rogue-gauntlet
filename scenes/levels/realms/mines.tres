[gd_resource type="Resource" script_class="Realm" load_steps=10 format=3]

[ext_resource type="Script" path="res://scenes/levels/generators/Realm.cs" id="realm"]
[ext_resource type="Script" path="res://scenes/levels/generators/FloorPlanChoice.cs" id="choice"]
[ext_resource type="Resource" path="res://scenes/levels/realms/jungle_corridors.tres" id="corridors"]
[ext_resource type="Resource" path="res://scenes/levels/lighting/atmosphere_profiles/mines.tres" id="atmosphere"]
[ext_resource type="Resource" path="res://scenes/levels/generators/floor_profiles/boss.tres" id="boss"]
[ext_resource type="Resource" path="res://scenes/levels/generators/floor_profiles/mines.tres" id="mines"]
[ext_resource type="Resource" path="res://scenes/levels/generators/floor_profiles/cluster_large.tres" id="cluster_large"]

[sub_resource type="Resource" id="plan_mines"]
script = ExtResource("choice")
Profile = ExtResource("mines")
Weight = 3.0

[sub_resource type="Resource" id="plan_cluster_large"]
script = ExtResource("choice")
Profile = ExtResource("cluster_large")
Weight = 1.0

[resource]
script = ExtResource("realm")
Id = "mines"
Theme = "jungle"
FirstDepth = 16
LastDepth = 20
Corridors = ExtResource("corridors")
Atmosphere = ExtResource("atmosphere")
FloorPlans = [SubResource("plan_mines"), SubResource("plan_cluster_large")]
BossProfile = ExtResource("boss")
