[sub_resource type="Resource" id="RectangleShape_1"]
script = ExtResource("2_RectangleSha")
Weight = 1.0
MinimumSize = Vector2i(4, 5)
MaximumSize = Vector2i(5, 7)
OddWidth = false
metadata/_custom_type_script = ExtResource("2_RectangleSha")

[sub_resource type="Resource" id="RowsStep_2"]
script = ExtResource("10_RowsStep")
Id = "tables"
Content = [ExtResource("11_dining_table")]
MinimumCount = 1
MaximumCount = 6
ColumnGap = 2.6
RowGap = 2.2
Margin = 2.4
