[sub_resource type="Resource" id="AlongWallsStep_3"]
script = ExtResource("12_AlongWallsSt")
Id = "provisions"
Content = [ExtResource("13_keg_station"), ExtResource("14_barrel_stati")]
MinimumCount = 0
MaximumCount = 2
Sides = 2
metadata/_custom_type_script = ExtResource("12_AlongWallsSt")

[sub_resource type="Resource" id="WallDecorStep_4"]
script = ExtResource("15_WallDecorSte")
Id = "door_torches"
Content = [ExtResource("16_torch"), ExtResource("17_torch_unlit")]
MaximumCount = 2
BesideDoorways = true
metadata/_custom_type_script = ExtResource("15_WallDecorSte")

[sub_resource type="Resource" id="WallDecorStep_5"]
script = ExtResource("15_WallDecorSte")
Id = "banners"
Content = [ExtResource("18_banner"), ExtResource("19_sword_shield")]
MaximumCount = 3
Spacing = 4.0
metadata/_custom_type_script = ExtResource("15_WallDecorSte")

[resource]
script = ExtResource("1_RoomType")
Id = "garrison.dining"
Shapes = [SubResource("RectangleShape_1")]
MinimumFloorTiles = 20
MinDoorways = 2
MaxDoorways = 3
DoorwayPlacement = 1
Walls = [ExtResource("3_stone_walls"), ExtResource("4_arched_walls"), ExtResource("5_pillared_wal")]
Floors = [ExtResource("6_stone_floor"), ExtResource("7_light_wood_f"), ExtResource("8_stone_border"), ExtResource("9_stone_border")]
Steps = [SubResource("RowsStep_2"), SubResource("AlongWallsStep_3"), SubResource("WallDecorStep_4"), SubResource("WallDecorStep_5")]
metadata/_custom_type_script = ExtResource("1_RoomType")
