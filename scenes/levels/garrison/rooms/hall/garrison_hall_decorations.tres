[gd_resource type="Resource" script_class="RoomArrangementPool" load_steps=6 format=3]

[ext_resource type="Script" path="res://scenes/levels/arrangements/RoomArrangementPool.cs" id="pool"]
[ext_resource type="Script" path="res://scenes/levels/arrangements/strategies/ConnectedArrangementStrategy.cs" id="strategy"]
[ext_resource type="Resource" path="res://scenes/levels/arrangements/wall/wall_banner.tres" id="banner"]
[ext_resource type="Resource" path="res://scenes/levels/arrangements/wall/wall_sword_shield.tres" id="shield"]

[sub_resource type="Resource" id="Strategy"]
script = ExtResource("strategy")

[resource]
script = ExtResource("pool")
Entries = [ExtResource("banner"), ExtResource("shield")]
PlacementStrategy = SubResource("Strategy")
MaximumPerRoom = 0
MaximumWallPerRoom = 5
PassageRadius = 1.0
metadata/_custom_type_script = ExtResource("pool")
