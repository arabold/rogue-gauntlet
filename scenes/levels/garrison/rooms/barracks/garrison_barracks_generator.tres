[gd_resource type="Resource" script_class="ModularRoomGenerator" load_steps=15 format=3]

[ext_resource type="Script" path="res://scenes/levels/generators/rooms/ModularRoomGenerator.cs" id="generator"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/rooms/barracks/garrison_barracks_shell.tres" id="shell"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/rooms/barracks/garrison_barracks_dressing.tres" id="dressing"]
[ext_resource type="Script" path="res://scenes/levels/generators/rooms/RoomLayoutVariant.cs" id="variant"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/columns/aisle_columns.tres" id="columns"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/base/rows.tres" id="base0"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/contents/bed_rows.tres" id="contents0"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/base/chamber.tres" id="base1"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/contents/sleeping_bays.tres" id="contents1"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/base/l_chamber.tres" id="base2"]
[ext_resource type="Resource" path="res://scenes/levels/garrison/layouts/contents/sleeping_bays.tres" id="contents2"]

[sub_resource type="Resource" id="Layout0"]
script = ExtResource("variant")
Id = "barracks.rows"
BaseLayout = ExtResource("base0")
Contents = ExtResource("contents0")
metadata/_custom_type_script = ExtResource("variant")

[sub_resource type="Resource" id="Layout1"]
script = ExtResource("variant")
Id = "barracks.bays"
BaseLayout = ExtResource("base1")
Contents = ExtResource("contents1")
metadata/_custom_type_script = ExtResource("variant")

[sub_resource type="Resource" id="Layout2"]
script = ExtResource("variant")
Id = "barracks.l_bays"
BaseLayout = ExtResource("base2")
Contents = ExtResource("contents2")
metadata/_custom_type_script = ExtResource("variant")

[resource]
script = ExtResource("generator")
MinimumFloorTiles = 6
ShellBuilder = ExtResource("shell")
Dressing = ExtResource("dressing")
Columns = ExtResource("columns")
Layouts = [SubResource("Layout0"), SubResource("Layout1"), SubResource("Layout2")]
metadata/_custom_type_script = ExtResource("generator")
