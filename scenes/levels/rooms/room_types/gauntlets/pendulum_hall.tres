[gd_resource type="Resource" script_class="RoomType" load_steps=27 format=3]

[ext_resource type="Script" path="res://scenes/levels/generators/assembly/RoomType.cs" id="room_type"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/shapes/RectangleShape.cs" id="rectangle"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/steps/PendulumRowsStep.cs" id="hazard_step"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/walls/stone_walls.tres" id="w_stone_walls"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/walls/prison_walls.tres" id="w_prison_walls"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/stone_floor.tres" id="f_stone_floor"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/flagstones_floor.tres" id="f_flagstones_floor"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/bricks_floor.tres" id="f_bricks_floor"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/steps/WallDecorStep.cs" id="wall_decor"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/steps/ScatterStep.cs" id="scatter"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/wall/torch.tres" id="torch"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/wall/sconce.tres" id="sconce"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/debris/bone_pile.tres" id="bone_pile"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/debris/floor_debris.tres" id="floor_debris"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/debris/rubble_scatter.tres" id="rubble_scatter"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/traps/pendulum_blade.tres" id="pendulum_blade"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/walls/slimy_walls.tres" id="t_slimy_walls"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/walls/cave_walls.tres" id="t_cave_walls"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/silted_bricks.tres" id="t_silted_bricks"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/drained_flagstones.tres" id="t_drained_flagstones"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/cave_floor.tres" id="t_cave_floor"]

[sub_resource type="Resource" id="shape"]
script = ExtResource("rectangle")
Weight = 1.0
MinimumSize = Vector2i(3, 6)
MaximumSize = Vector2i(3, 8)
OddWidth = true
metadata/_custom_type_script = ExtResource("rectangle")

[sub_resource type="Resource" id="blade_rows"]
script = ExtResource("hazard_step")
Id = "blade_rows"
Content = [ExtResource("pendulum_blade")]
MinimumCount = 4
MaximumCount = 6
Uniform = true
Pattern = 2
PeriodRange = Vector2(1.8, 2.4)
metadata/_custom_type_script = ExtResource("hazard_step")

[sub_resource type="Resource" id="torches"]
script = ExtResource("wall_decor")
Id = "torches"
Content = [ExtResource("torch"), ExtResource("sconce")]
MaximumCount = 2
Spacing = 6.0
metadata/_custom_type_script = ExtResource("wall_decor")

[sub_resource type="Resource" id="undead_remains"]
script = ExtResource("scatter")
Id = "undead_remains"
Content = [ExtResource("bone_pile"), ExtResource("floor_debris")]
MaximumCount = 3
Motifs = PackedStringArray("undead")
metadata/_custom_type_script = ExtResource("scatter")

[sub_resource type="Resource" id="decay"]
script = ExtResource("scatter")
Id = "decay"
Content = [ExtResource("rubble_scatter"), ExtResource("floor_debris")]
MaximumCount = 3
Motifs = PackedStringArray("decay")
metadata/_custom_type_script = ExtResource("scatter")

[resource]
script = ExtResource("room_type")
Id = "pendulum_hall"
Realms = PackedStringArray("garrison", "sewer", "jungle")
Shapes = [SubResource("shape")]
MinimumFloorTiles = 18
MinDoorways = 2
MaxDoorways = 2
DoorwayPlacement = 1
DoorChance = 0.0
FrameChance = 0.5
Circulation = 1
Walls = [ExtResource("w_stone_walls"), ExtResource("w_prison_walls"), ExtResource("t_slimy_walls"), ExtResource("t_cave_walls")]
Floors = [ExtResource("f_stone_floor"), ExtResource("f_flagstones_floor"), ExtResource("f_bricks_floor"), ExtResource("t_silted_bricks"), ExtResource("t_drained_flagstones"), ExtResource("t_cave_floor")]
Steps = [SubResource("blade_rows"), SubResource("torches"), SubResource("undead_remains"), SubResource("decay")]
metadata/_custom_type_script = ExtResource("room_type")
