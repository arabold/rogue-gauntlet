[sub_resource type="Resource" id="RectangleShape_vault"]
script = ExtResource("rectangle")
MinimumSize = Vector2i(3, 6)
MaximumSize = Vector2i(5, 10)

[sub_resource type="Resource" id="ArcadeStep_bays"]
script = ExtResource("arcade")
Id = "arcade"
Content = [ExtResource("arcade_arch")]
MinimumCount = 1
MaximumCount = 3
Pier = ExtResource("arcade_pier")

[sub_resource type="Resource" id="AlongWallsStep_pipework"]
script = ExtResource("along")
Id = "pipework"
Content = [ExtResource("valve"), ExtResource("pipe_run"), ExtResource("pipe_outlet")]
MaximumCount = 3
Spacing = 0.8

[sub_resource type="Resource" id="CornersStep_debris"]
script = ExtResource("corners")
Id = "corner_debris"
Content = [ExtResource("rubble"), ExtResource("barrel_stack"), ExtResource("bone_pile"), ExtResource("goo_barrel")]
MaximumCount = 4

[sub_resource type="Resource" id="ScatterStep_flotsam"]
script = ExtResource("scatter")
Id = "flotsam"
Content = [ExtResource("barrel"), ExtResource("bucket"), ExtResource("floor_debris"), ExtResource("bone_pile"), ExtResource("goo_puddle"), ExtResource("goo_barrel")]
MaximumCount = 10
WallChance = 0.7

[sub_resource type="Resource" id="WallDecorStep_torches"]
script = ExtResource("decor")
Id = "torches"
Content = [ExtResource("torch")]
MaximumCount = 4
Spacing = 6.0

[sub_resource type="Resource" id="PoolStep_flooding"]
script = ExtResource("motif_PoolStep")
Id = "flooding"
Layout = 0
MinimumCount = 0
MaximumCount = 2
Center = ExtResource("motif_pool_center")
Edge = ExtResource("motif_pool_edge")
Corner = ExtResource("motif_pool_corner")
Runner = ExtResource("motif_pool_runner")
RunnerEnd = ExtResource("motif_pool_runner_end")
MinimumSize = Vector2i(1, 2)
MaximumSize = Vector2i(2, 2)
Motifs = PackedStringArray("flooded")
metadata/_custom_type_script = ExtResource("motif_PoolStep")

[resource]
script = ExtResource("room_type")
Id = "sewer_vault"
Realms = PackedStringArray("sewer")
Shapes = [SubResource("RectangleShape_vault")]
MinimumFloorTiles = 18
MinDoorways = 2
MaxDoorways = 3
Walls = [ExtResource("slimy_walls"), ExtResource("arched_walls")]
Floors = [ExtResource("grated_flagstones"), ExtResource("drained_flagstones"), ExtResource("bricks_bordered_flagstones"), ExtResource("channel_flagstones")]
Steps = [SubResource("PoolStep_flooding"), SubResource("ArcadeStep_bays"), SubResource("AlongWallsStep_pipework"), SubResource("CornersStep_debris"), SubResource("ScatterStep_flotsam"), SubResource("WallDecorStep_torches")]
