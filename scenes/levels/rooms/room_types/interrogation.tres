[sub_resource type="Resource" id="RectangleShape_interrogation"]
script = ExtResource("rectangle")
MinimumSize = Vector2i(3, 3)
MaximumSize = Vector2i(4, 4)

[sub_resource type="Resource" id="CenterStep_block"]
script = ExtResource("center")
Id = "block"
Content = [ExtResource("torture_rack"), ExtResource("chopping_block"), ExtResource("chair")]
MaximumCount = 1

[sub_resource type="Resource" id="CornersStep_fire"]
script = ExtResource("corners")
Id = "fire"
Content = [ExtResource("brazier"), ExtResource("cauldron")]
MaximumCount = 2

[sub_resource type="Resource" id="WallDecorStep_shackles"]
script = ExtResource("decor")
Id = "shackles"
Content = [ExtResource("shackles"), ExtResource("keyring")]
MaximumCount = 3

[sub_resource type="Resource" id="AlongWallsStep_punishment"]
script = ExtResource("along_walls")
Id = "punishment"
Content = [ExtResource("stocks"), ExtResource("iron_maiden")]
MaximumCount = 2
Chance = 0.8
AvoidDoorwayWalls = true
Centered = true

[sub_resource type="Resource" id="WallDecorStep_cage"]
script = ExtResource("decor")
Id = "cage"
Content = [ExtResource("hanging_cage")]
MaximumCount = 1
Chance = 0.5

[sub_resource type="Resource" id="ScatterStep_remains"]
script = ExtResource("scatter")
Id = "remains"
Content = [ExtResource("bone_pile"), ExtResource("bucket"), ExtResource("straw_pile")]
MaximumCount = 2

[resource]
script = ExtResource("room_type")
Id = "interrogation"
Realms = PackedStringArray("garrison", "sewer", "jungle")
Shapes = [SubResource("RectangleShape_interrogation")]
MinimumFloorTiles = 9
MinDoorways = 1
MaxDoorways = 1
DoorwayPlacement = 3
DoorChance = 1.0
Walls = [ExtResource("prison"), ExtResource("stone"), ExtResource("crypt")]
Floors = [ExtResource("stone_floor"), ExtResource("flagstones_floor"), ExtResource("bricks_floor"), ExtResource("earth_floor")]
Steps = [SubResource("CenterStep_block"), SubResource("WallDecorStep_cage"), SubResource("AlongWallsStep_punishment"), SubResource("CornersStep_fire"), SubResource("WallDecorStep_shackles"), SubResource("ScatterStep_remains")]
