[gd_resource type="Resource" script_class="RoomType" load_steps=25 format=3]

[ext_resource type="Script" path="res://scenes/levels/generators/assembly/RoomType.cs" id="2_roomtype"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/shapes/RectangleShape.cs" id="3_rectangleshape"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/walls/slimy_walls.tres" id="4_slimy_walls"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/walls/stone_walls.tres" id="5_stone_walls"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/channel_flagstones.tres" id="6_channel_flagston"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/styles/floors/bricks_floor.tres" id="7_bricks_floor"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/storage/barrel.tres" id="8_barrel"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/storage/bucket.tres" id="9_bucket"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/debris/bone_pile.tres" id="10_bone_pile"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/debris/floor_debris.tres" id="11_floor_debris"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/storage/small_box.tres" id="12_small_box"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/steps/ScatterStep.cs" id="13_scatterstep"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/wall/torch_unlit.tres" id="14_torch_unlit"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/wall/torch.tres" id="15_torch"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/steps/WallDecorStep.cs" id="16_walldecorstep"]
[ext_resource type="Script" path="res://scenes/levels/generators/assembly/steps/AlongWallsStep.cs" id="p_AlongWallsStep"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/fixtures/pipe_outlet.tres" id="p_pipe_outlet"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/fixtures/pipe_run.tres" id="p_pipe_run"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/fixtures/valve.tres" id="p_valve"]
[ext_resource type="Resource" path="res://scenes/levels/rooms/props/debris/goo_puddle.tres" id="p_goo_puddle"]

[sub_resource type="Resource" id="RectangleShape_1"]
script = ExtResource("3_rectangleshape")
MinimumSize = Vector2i(2, 3)
MaximumSize = Vector2i(3, 5)
OddWidth = false
metadata/_custom_type_script = ExtResource("3_rectangleshape")

[sub_resource type="Resource" id="ScatterStep_2"]
script = ExtResource("13_scatterstep")
Id = "clutter"
Content = [ExtResource("8_barrel"), ExtResource("9_bucket"), ExtResource("10_bone_pile"), ExtResource("11_floor_debris"), ExtResource("12_small_box"), ExtResource("p_goo_puddle")]
MaximumCount = 3
WallChance = 1.0
metadata/_custom_type_script = ExtResource("13_scatterstep")

[sub_resource type="Resource" id="WallDecorStep_3"]
script = ExtResource("16_walldecorstep")
Id = "torches"
Content = [ExtResource("14_torch_unlit"), ExtResource("14_torch_unlit"), ExtResource("15_torch")]
MaximumCount = 2
Spacing = 6.0
metadata/_custom_type_script = ExtResource("16_walldecorstep")

[sub_resource type="Resource" id="AlongWallsStep_outfalls"]
script = ExtResource("p_AlongWallsStep")
Id = "outfalls"
Content = [ExtResource("p_pipe_outlet"), ExtResource("p_pipe_run"), ExtResource("p_valve")]
MaximumCount = 2
Spacing = 0.8
metadata/_custom_type_script = ExtResource("p_AlongWallsStep")

[resource]
script = ExtResource("2_roomtype")
Id = "drain_tunnel"
Realms = PackedStringArray("sewer")
Shapes = [SubResource("RectangleShape_1")]
MinimumFloorTiles = 6
MinDoorways = 2
MaxDoorways = 2
DoorwayPlacement = 1
Circulation = 1
Walls = [ExtResource("4_slimy_walls"), ExtResource("5_stone_walls")]
Floors = [ExtResource("6_channel_flagston"), ExtResource("7_bricks_floor")]
Steps = [SubResource("AlongWallsStep_outfalls"), SubResource("ScatterStep_2"), SubResource("WallDecorStep_3")]
metadata/_custom_type_script = ExtResource("2_roomtype")
