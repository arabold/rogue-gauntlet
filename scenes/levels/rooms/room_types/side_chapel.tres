[sub_resource type="Resource" id="RectangleShape_chapel"]
script = ExtResource("rectangle")
MinimumSize = Vector2i(3, 3)
MaximumSize = Vector2i(4, 4)

[sub_resource type="Resource" id="AlongWallsStep_altar"]
script = ExtResource("along")
Id = "altar"
Content = [ExtResource("altar"), ExtResource("altar_shrine")]
MinimumCount = 1
MaximumCount = 1
AvoidDoorwayWalls = true

[sub_resource type="Resource" id="CornersStep_candles"]
script = ExtResource("corners")
Id = "candles"
Content = [ExtResource("candle_pile"), ExtResource("candle_corner"), ExtResource("candle_ring"), ExtResource("candelabra")]
MaximumCount = 3

[sub_resource type="Resource" id="AlongWallsStep_statue"]
script = ExtResource("along")
Id = "statue"
Content = [ExtResource("statue"), ExtResource("bust")]
MaximumCount = 1
Chance = 0.5

[sub_resource type="Resource" id="WallDecorStep_hangings"]
script = ExtResource("decor")
Id = "hangings"
Content = [ExtResource("sconce"), ExtResource("tapestry_red"), ExtResource("tapestry_blue"), ExtResource("tapestry_green")]
MaximumCount = 2

[sub_resource type="Resource" id="WallDecorStep_vampire_hangings"]
script = ExtResource("decor")
Id = "vampire_hangings"
Content = [ExtResource("tapestry_red"), ExtResource("motif_banner_red")]
MaximumCount = 3
Spacing = 2.5
Motifs = PackedStringArray("vampire")
metadata/_custom_type_script = ExtResource("decor")

[resource]
script = ExtResource("room_type")
Id = "side_chapel"
Realms = PackedStringArray("garrison", "sewer", "jungle")
Weight = 3.0
Shapes = [SubResource("RectangleShape_chapel")]
MinimumFloorTiles = 9
MinDoorways = 1
MaxDoorways = 1
DoorwayPlacement = 3
Walls = [ExtResource("arched"), ExtResource("crypt"), ExtResource("pillared"), ExtResource("mossy")]
Floors = [ExtResource("decorated_floor"), ExtResource("checker_floor"), ExtResource("flagstones_floor"), ExtResource("bricks_floor"), ExtResource("flagstones_ruined_floor")]
Steps = [SubResource("AlongWallsStep_altar"), SubResource("CornersStep_candles"), SubResource("AlongWallsStep_statue"), SubResource("WallDecorStep_hangings"), SubResource("WallDecorStep_vampire_hangings")]
