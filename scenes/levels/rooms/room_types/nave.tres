[sub_resource type="Resource" id="RectangleShape_nave"]
script = ExtResource("rectangle")
MinimumSize = Vector2i(5, 9)
MaximumSize = Vector2i(5, 11)
OddWidth = true

[sub_resource type="Resource" id="AisleColumns_nave"]
script = ExtResource("aisle")
Id = "aisle"
Column = [ExtResource("pillar"), ExtResource("pillar_ornate")]
Spacing = 2

[sub_resource type="Resource" id="AlongWallsStep_altar"]
script = ExtResource("along")
Id = "altar"
Content = [ExtResource("altar"), ExtResource("altar_shrine")]
MinimumCount = 0
MaximumCount = 1
AvoidDoorwayWalls = true

[sub_resource type="Resource" id="RowsStep_pews"]
script = ExtResource("rows")
Id = "pews"
Content = [ExtResource("bench")]
MinimumCount = 0
MaximumCount = 48
CenterAisle = 2.6
ColumnGap = 0.3
RowGap = 1.3
Margin = 1.2

[sub_resource type="Resource" id="AlongWallsStep_statues"]
script = ExtResource("along")
Id = "statues"
Content = [ExtResource("statue"), ExtResource("candle_pile"), ExtResource("candle_arc")]
MaximumCount = 4
Chance = 0.8
Spacing = 2.0

[sub_resource type="Resource" id="CornersStep_fire"]
script = ExtResource("corners")
Id = "fire_bowls"
Content = [ExtResource("brazier"), ExtResource("candle_ring"), ExtResource("candle_pile")]
MaximumCount = 4

[sub_resource type="Resource" id="WallDecorStep_hangings"]
script = ExtResource("decor")
Id = "hangings"
Content = [ExtResource("tapestry_red"), ExtResource("tapestry_blue"), ExtResource("tapestry_green"), ExtResource("sconce")]
MaximumCount = 4

[sub_resource type="Resource" id="WallDecorStep_torches"]
script = ExtResource("decor")
Id = "door_torches"
Content = [ExtResource("torch")]
MaximumCount = 2
BesideDoorways = true

[resource]
script = ExtResource("room_type")
Id = "nave"
Realms = PackedStringArray("garrison", "sewer", "jungle")
Shapes = [SubResource("RectangleShape_nave")]
MinimumFloorTiles = 45
MinDoorways = 2
MaxDoorways = 2
DoorwayPlacement = 1
Circulation = 1
Walls = [ExtResource("pillared"), ExtResource("arched"), ExtResource("crypt"), ExtResource("mossy")]
Floors = [ExtResource("checker_runner"), ExtResource("decorated"), ExtResource("flagstones"), ExtResource("flagstones_ruined"), ExtResource("bricks")]
Columns = [SubResource("AisleColumns_nave")]
ColumnChance = 1.0
Steps = [SubResource("AlongWallsStep_altar"), SubResource("RowsStep_pews"), SubResource("AlongWallsStep_statues"), SubResource("CornersStep_fire"), SubResource("WallDecorStep_hangings"), SubResource("WallDecorStep_torches")]
