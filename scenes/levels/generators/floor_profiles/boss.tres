[sub_resource type="Resource" id="LinearRoomLayout"]
script = ExtResource("layout")

[sub_resource type="Resource" id="AStarCorridorConnector"]
script = ExtResource("connector")

[resource]
script = ExtResource("profile")
Layout = SubResource("LinearRoomLayout")
