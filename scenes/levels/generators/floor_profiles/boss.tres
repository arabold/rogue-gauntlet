[gd_resource type="Resource" script_class="FloorProfile" load_steps=8 format=3]

[ext_resource type="Script" path="res://scenes/levels/generators/FloorProfile.cs" id="profile"]
[ext_resource type="Script" path="res://scenes/levels/generators/layouts/LinearRoomLayout.cs" id="layout"]
[ext_resource type="Script" path="res://scenes/levels/generators/connectors/AStarCorridorConnector.cs" id="connector"]
[ext_resource type="Resource" path="res://scenes/levels/access/floor_access_profiles/rare_lock.tres" id="access"]
