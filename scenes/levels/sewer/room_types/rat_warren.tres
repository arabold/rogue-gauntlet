[sub_resource type="Resource" id="RectangleShape_1"]
script = ExtResource("3_rectangleshape")
MinimumSize = Vector2i(4, 4)
MaximumSize = Vector2i(5, 6)
OddWidth = false
metadata/_custom_type_script = ExtResource("3_rectangleshape")

[sub_resource type="Resource" id="LShape_2"]
script = ExtResource("4_lshape")
MinimumSize = Vector2i(4, 4)
MaximumSize = Vector2i(5, 5)
ArmWidth = 2
metadata/_custom_type_script = ExtResource("4_lshape")

[sub_resource type="Resource" id="CornersStep_3"]
script = ExtResource("11_cornersstep")
Id = "nests"
Content = [ExtResource("9_straw_pile"), ExtResource("10_bone_pile")]
MinimumCount = 1
MaximumCount = 3
metadata/_custom_type_script = ExtResource("11_cornersstep")

[sub_resource type="Resource" id="ScatterStep_4"]
script = ExtResource("15_scatterstep")
Id = "gnawed"
Content = [ExtResource("10_bone_pile"), ExtResource("9_straw_pile"), ExtResource("12_floor_debris"), ExtResource("13_vase_broken"), ExtResource("14_sack"), ExtResource("p_goo_puddle")]
MaximumCount = 5
WallChance = 0.5
metadata/_custom_type_script = ExtResource("15_scatterstep")

[sub_resource type="Resource" id="ScatterStep_5"]
script = ExtResource("15_scatterstep")
Id = "rubble"
Content = [ExtResource("16_rubble")]
MaximumCount = 2
WallChance = 0.8
Chance = 0.6
metadata/_custom_type_script = ExtResource("15_scatterstep")

[sub_resource type="Resource" id="WallDecorStep_6"]
script = ExtResource("18_walldecorstep")
Id = "torches"
Content = [ExtResource("17_torch_unlit")]
MaximumCount = 1
Chance = 0.5
metadata/_custom_type_script = ExtResource("18_walldecorstep")

[resource]
script = ExtResource("2_roomtype")
Id = "sewer.rat_warren"
Weight = 0.8
Shapes = [SubResource("RectangleShape_1"), SubResource("LShape_2")]
MinimumFloorTiles = 14
MinDoorways = 1
MaxDoorways = 3
Circulation = 0
Walls = [ExtResource("5_ruined_walls"), ExtResource("6_slimy_walls")]
Floors = [ExtResource("7_earth_floor"), ExtResource("8_flagstones_ruine")]
Steps = [SubResource("CornersStep_3"), SubResource("ScatterStep_4"), SubResource("ScatterStep_5"), SubResource("WallDecorStep_6")]
metadata/_custom_type_script = ExtResource("2_roomtype")
