[sub_resource type="Resource" id="CrossShape_1"]
script = ExtResource("3_crossshape")
MinimumSize = Vector2i(5, 5)
MaximumSize = Vector2i(5, 5)
ArmWidth = 3
metadata/_custom_type_script = ExtResource("3_crossshape")

[sub_resource type="Resource" id="TShape_2"]
script = ExtResource("4_tshape")
MinimumSize = Vector2i(5, 4)
MaximumSize = Vector2i(5, 5)
StemWidth = 3
BarDepth = 2
metadata/_custom_type_script = ExtResource("4_tshape")

[sub_resource type="Resource" id="ScatterStep_3"]
script = ExtResource("13_scatterstep")
Id = "debris"
Content = [ExtResource("9_rubble"), ExtResource("10_floor_debris"), ExtResource("11_bone_pile"), ExtResource("12_barrel"), ExtResource("p_goo_puddle")]
MaximumCount = 3
WallChance = 0.9
metadata/_custom_type_script = ExtResource("13_scatterstep")

[sub_resource type="Resource" id="WallDecorStep_4"]
script = ExtResource("16_walldecorstep")
Id = "torches"
Content = [ExtResource("14_torch_unlit"), ExtResource("14_torch_unlit"), ExtResource("15_torch")]
MaximumCount = 2
Spacing = 6.0
metadata/_custom_type_script = ExtResource("16_walldecorstep")

[sub_resource type="Resource" id="AlongWallsStep_pipework"]
script = ExtResource("p_AlongWallsStep")
Id = "pipework"
Content = [ExtResource("p_valve"), ExtResource("p_pipe_run")]
MaximumCount = 2
Spacing = 0.8
metadata/_custom_type_script = ExtResource("p_AlongWallsStep")

[resource]
script = ExtResource("2_roomtype")
Id = "sewer.junction"
Weight = 0.8
Shapes = [SubResource("CrossShape_1"), SubResource("TShape_2")]
MinimumFloorTiles = 15
MinDoorways = 2
MaxDoorways = 4
Circulation = 0
Walls = [ExtResource("5_slimy_walls"), ExtResource("6_arched_walls")]
Floors = [ExtResource("7_grated_flagstone"), ExtResource("8_drained_flagston")]
Steps = [SubResource("AlongWallsStep_pipework"), SubResource("ScatterStep_3"), SubResource("WallDecorStep_4")]
metadata/_custom_type_script = ExtResource("2_roomtype")
