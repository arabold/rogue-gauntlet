[gd_resource type="Resource" script_class="EnemyCombatProfile" load_steps=13 format=3]

[ext_resource type="Script" path="res://scenes/enemies/EnemyCombatProfile.cs" id="profile"]
[ext_resource type="Script" path="res://scenes/enemies/actions/MonsterAttackAction.cs" id="action"]
[ext_resource type="Script" path="res://scenes/enemies/actions/MonsterDashAction.cs" id="dash_action"]
[ext_resource type="Script" path="res://scenes/combat/DashProfile.cs" id="dash_profile"]
[ext_resource type="Script" path="res://scenes/attacks/AttackDefinition.cs" id="attack"]
[ext_resource type="Script" path="res://scenes/attacks/OnHitStatusProfile.cs" id="on_hit"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/engagement_tactics.tres" id="tactics"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/bite_and_dart.tres" id="movement"]
[ext_resource type="Resource" path="res://scenes/enemies/snake/snake_contact.tres" id="contact"]
[ext_resource type="Resource" path="res://scenes/buffs/snake_venom.tres" id="venom"]

[sub_resource type="Resource" id="venom_on_hit"]
script = ExtResource("on_hit")
Effect = ExtResource("venom")
Chance = 0.6

[sub_resource type="Resource" id="bite_attack"]
script = ExtResource("attack")
MeleeContact = ExtResource("contact")
OnHitStatuses = [SubResource("venom_on_hit")]
PoiseDamage = 6.0
HitStopDuration = 0.03
FacingLockLead = 0.1
WindUpTurnRate = 540.0
Commit = 0.5

[sub_resource type="Resource" id="bite"]
resource_name = "Bite"
script = ExtResource("action")
Cooldown = 1.9
MaximumRange = 1.8
RiposteEligible = true
Attack = SubResource("bite_attack")
Style = &"bite"
Duration = 0.66
MinDamage = 2.5
MaxDamage = 5.0

[sub_resource type="Resource" id="lunge_dash"]
script = ExtResource("dash_profile")
Style = &"bite"
WindUpDuration = 0.25
Distance = 3.0
TravelDuration = 0.35

[sub_resource type="Resource" id="lunge"]
resource_name = "Lunge"
script = ExtResource("dash_action")
Weight = 1.0
Cooldown = 2.2
MinimumRange = 2.0
MaximumRange = 4.5
Dash = SubResource("lunge_dash")

[resource]
script = ExtResource("profile")
TacticalStrategy = ExtResource("tactics")
MovementStrategy = ExtResource("movement")
Actions = [SubResource("bite"), SubResource("lunge")]
