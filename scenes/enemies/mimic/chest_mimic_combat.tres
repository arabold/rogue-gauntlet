[ext_resource type="Resource" path="res://scenes/enemies/strategies/close_distance.tres" id="movement"]
[ext_resource type="Resource" path="res://scenes/enemies/mimic/chest_mimic_bite.tres" id="bite_contact"]
[ext_resource type="Resource" path="res://scenes/enemies/mimic/chest_mimic_lash.tres" id="lash_contact"]

[sub_resource type="Resource" id="bite_attack"]
