[gd_resource type="Resource" script_class="EnemyCombatProfile" load_steps=9 format=3]

[ext_resource type="Script" path="res://scenes/enemies/EnemyCombatProfile.cs" id="profile"]
[ext_resource type="Script" path="res://scenes/enemies/actions/MonsterAttackAction.cs" id="attack_action"]
[ext_resource type="Script" path="res://scenes/attacks/AttackDefinition.cs" id="attack_definition"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/engagement_tactics.tres" id="tactics"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/engagement_ring.tres" id="movement"]
[ext_resource type="Resource" path="res://scenes/attacks/melee_profiles/monster_skeleton_minion.tres" id="contact"]

[sub_resource type="Resource" id="strike_attack"]
script = ExtResource("attack_definition")
MeleeContact = ExtResource("contact")
HitWindowStart = 0.3
HitWindowEnd = 0.7
PoiseDamage = 10.0
HitStopDuration = 0.03
FacingLockLead = 0.15
WindUpTurnRate = 360.0

[sub_resource type="Resource" id="strike"]
resource_name = "strike"
script = ExtResource("attack_action")
Cooldown = 1.2
MaximumRange = 2.4
RiposteEligible = true
Attack = SubResource("strike_attack")
Style = &"melee"
Duration = 1.0
MinDamage = 1.0
MaxDamage = 5.0

[resource]
script = ExtResource("profile")
TacticalStrategy = ExtResource("tactics")
MovementStrategy = ExtResource("movement")
Actions = [SubResource("strike")]
