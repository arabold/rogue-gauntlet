[gd_resource type="Resource" script_class="EnemyCombatProfile" load_steps=10 format=3]

[ext_resource type="Script" path="res://scenes/enemies/EnemyCombatProfile.cs" id="profile"]
[ext_resource type="Script" path="res://scenes/enemies/actions/MonsterAttackAction.cs" id="attack_action"]
[ext_resource type="Script" path="res://scenes/attacks/AttackDefinition.cs" id="attack_definition"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/engagement_tactics.tres" id="tactics"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/close_distance.tres" id="movement"]
[ext_resource type="Resource" path="res://scenes/attacks/melee_profiles/large_unarmed_punch.tres" id="punch_contact"]
[ext_resource type="Resource" path="res://scenes/attacks/melee_profiles/large_unarmed_smash.tres" id="smash_contact"]

[sub_resource type="Resource" id="punch_swing"]
script = ExtResource("attack_definition")
MeleeContact = ExtResource("punch_contact")
PoiseDamage = 30.0
Knockback = 5.0
HitStopDuration = 0.05
FacingLockLead = 0.25
WindUpTurnRate = 90.0
Commit = 0.5

[sub_resource type="Resource" id="smash_swing"]
script = ExtResource("attack_definition")
MeleeContact = ExtResource("smash_contact")
DefenseTraits = 15
PoiseDamage = 40.0
Knockback = 7.0
HyperArmorEnd = 0.4
Interruptible = false
HitStopDuration = 0.07
FacingLockLead = 0.3
WindUpTurnRate = 45.0
