[sub_resource type="Resource" id="punch"]
resource_name = "punch"
script = ExtResource("attack_action")
Cooldown = 2.5
MaximumRange = 3.4
MaximumStartAngle = 45.0
Attack = SubResource("punch_swing")
Style = &"melee"
Duration = 1.22
MinDamage = 11.0
MaxDamage = 22.5

[sub_resource type="Resource" id="smash"]
resource_name = "smash"
script = ExtResource("attack_action")
Weight = 0.6
Cooldown = 6.0
MaximumRange = 3.8
MaximumStartAngle = 50.0
Attack = SubResource("smash_swing")
Style = &"smash"
Duration = 2.6
MinDamage = 19.5
MaxDamage = 30.5

[resource]
script = ExtResource("profile")
TacticalStrategy = ExtResource("tactics")
MovementStrategy = ExtResource("movement")
Actions = [SubResource("punch"), SubResource("smash")]
RepeatWeightMultiplier = 0.4
