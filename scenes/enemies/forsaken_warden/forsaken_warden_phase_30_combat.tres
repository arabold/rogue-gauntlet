[gd_resource type="Resource" script_class="EnemyCombatProfile" load_steps=12 format=3]

[ext_resource type="Script" path="res://scenes/enemies/EnemyCombatProfile.cs" id="profile"]
[ext_resource type="Script" path="res://scenes/enemies/actions/EnemyActionChoiceProfile.cs" id="choice_script"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/engagement_tactics.tres" id="tactics"]
[ext_resource type="Resource" path="res://scenes/enemies/strategies/close_distance.tres" id="movement"]
[ext_resource type="Resource" path="res://scenes/enemies/forsaken_warden/forsaken_warden_defense.tres" id="defense"]
[ext_resource type="Resource" path="res://scenes/enemies/forsaken_warden/forsaken_warden_attack.tres" id="slash"]
[ext_resource type="Resource" path="res://scenes/enemies/forsaken_warden/forsaken_warden_overhead_attack.tres" id="overhead"]
[ext_resource type="Resource" path="res://scenes/enemies/forsaken_warden/forsaken_warden_stomp_attack.tres" id="stomp"]

[sub_resource type="Resource" id="slash_choice"]
script = ExtResource("choice_script")
Action = ExtResource("slash")
Weight = 0.4

[sub_resource type="Resource" id="overhead_choice"]
script = ExtResource("choice_script")
Action = ExtResource("overhead")
Weight = 1.2

[sub_resource type="Resource" id="stomp_choice"]
script = ExtResource("choice_script")
Action = ExtResource("stomp")
Weight = 1.0

[resource]
script = ExtResource("profile")
TacticalStrategy = ExtResource("tactics")
MovementStrategy = ExtResource("movement")
DefenseStrategy = ExtResource("defense")
ApproachAction = ExtResource("slash")
Actions = [SubResource("slash_choice"), SubResource("overhead_choice"), SubResource("stomp_choice")]
RepeatWeightMultiplier = 0.25
