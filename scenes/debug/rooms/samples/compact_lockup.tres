MinimumCount = 1
MaximumCount = 1
Sides = 1
metadata/_custom_type_script = ExtResource("along")

[sub_resource type="Resource" id="straw"]
script = ExtResource("scatter")
Id = "straw"
Content = [ExtResource("straw")]
MaximumCount = 2
