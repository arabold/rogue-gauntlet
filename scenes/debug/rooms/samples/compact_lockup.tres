[sub_resource type="Resource" id="shape"]
script = ExtResource("shape")
MinimumSize = Vector2i(4, 4)
MaximumSize = Vector2i(4, 4)
metadata/_custom_type_script = ExtResource("shape")

[sub_resource type="Resource" id="cells"]
script = ExtResource("cells")
Id = "two_cells"
Content = [ExtResource("bedding")]
MinimumCount = 2
MaximumCount = 2
WallLibrary = ExtResource("bars")
Gate = ExtResource("gate")
EndClearance = 2.0
OpposingChance = 0.0
FirstRowSide = 2
CellFloor = ExtResource("dirt")
metadata/_custom_type_script = ExtResource("cells")

[sub_resource type="Resource" id="guard"]
script = ExtResource("along")
Id = "guard_post"
Content = [ExtResource("table")]
MinimumCount = 1
MaximumCount = 1
Sides = 1
Centered = true
AvoidDoorwayWalls = true
metadata/_custom_type_script = ExtResource("along")

[sub_resource type="Resource" id="shackles"]
script = ExtResource("decor")
Id = "shackles"
